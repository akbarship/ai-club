# --- Required ---
# Token from @BotFather
BOT_TOKEN=
# Public HTTPS URL where the mini app is served (this server in prod, or a tunnel to Vite in dev)
WEBAPP_URL=https://example.com
# Telegram IDs of admins, comma separated (get yours from @userinfobot)
ADMIN_IDS=123456789

# --- Channel subscription gate ---
# Channel username (@my_channel) or numeric id (-100...). The bot MUST be an admin of this channel.
CHANNEL_ID=@my_channel
CHANNEL_URL=https://t.me/my_channel

# --- Optional ---
PORT=3000
DATA_DIR=./data
# Timezone offset used for daily stats (Tashkent = 5)
TZ_OFFSET_HOURS=5
# If set, the bot uses a webhook at WEBHOOK_URL/tg/webhook instead of long polling
WEBHOOK_URL=
# Local development only: lets you open the app in a normal browser as this Telegram user
DEV_USER_ID=
