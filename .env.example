# Copy to .env for local work. On Vercel, add the same keys in Project Settings → Environment Variables.

# --- Telegram ---
# Token from @BotFather
BOT_TOKEN=
# Telegram IDs of admins, comma separated (get yours from @userinfobot)
ADMIN_IDS=
# Channel for the subscription gate. The bot MUST be an admin of this channel.
CHANNEL_ID=@my_channel
CHANNEL_URL=https://t.me/my_channel
# Public https address of the app, e.g. https://ai-club.vercel.app (no trailing slash)
WEBAPP_URL=

# --- Supabase ---
# Project Settings → Database → Connection string → "Transaction pooler" (port 6543)
DATABASE_URL=
# Project Settings → API: project URL and the service_role key (server only, never in client code)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Optional ---
# Timezone offset used for daily stats (Tashkent = 5)
TZ_OFFSET_HOURS=5
# Max database connections per server instance
DB_POOL_MAX=3
# Bot @username without @; saves a Telegram call on cold starts
BOT_USERNAME=
# Local development only: open the app in a normal browser as this Telegram user
DEV_USER_ID=
